<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <size
                android:width="320dp"
                android:height="180dp" />
            <gradient
                android:angle="135"
                android:endColor="#0B2B38"
                android:startColor="#031117" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <item
        android:bottom="50dp"
        android:left="110dp"
        android:right="110dp"
        android:top="50dp">
        <shape android:shape="oval">
            <solid android:color="#00D4B2" />
        </shape>
    </item>
</layer-list>
